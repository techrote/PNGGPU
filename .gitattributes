*.mjs text eol=lf
*.js text eol=lf
*.wgsl text eol=lf
*.cu text eol=lf
*.cpp text eol=lf
*.hpp text eol=lf
*.py text eol=lf
*.json text eol=lf
*.md text eol=lf
*.html text eol=lf
*.yml text eol=lf
*.png binary
*.ans binary
