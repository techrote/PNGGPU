{
  "name": "PNGGPU WebGPU and optional Turing CUDA source package",
  "release": "GPU-007+CUDA-001",
  "distribution_type": "cumulative Windows one-click installer; pinned original PNG2ANSI source downloaded once if absent",
  "base_repo": "techrote/PNG2ANSI",
  "base_commit": "67ae97295ab9a9ab32fdee5410c2371e4b21ce87",
  "previous_GPU_version_required": false,
  "runner": "start.bat",
  "installer": "setup.bat",
  "test": "test.bat",
  "cpu_reference_work_units": 125000000,
  "gpu_max_safe_integer_work_units": 9007199254740991,
  "gpu_tile_projection_mib_choices": [
    4,
    8,
    16,
    32,
    64,
    128,
    256,
    512,
    1024
  ],
  "gpu_in_flight_options": [
    1,
    2,
    3,
    4,
    6,
    8,
    12,
    16,
    24
  ],
  "gpu_max_geometry": {
    "columns": 1024,
    "rows": 1024,
    "sample_width": 32,
    "sample_height": 64
  },
  "features": [
    "automatic VRAM estimation",
    "streamed large-raster input",
    "folder image batch to ANSI ZIP",
    "optional timing CSV/JSON",
    "extended pipeline depth",
    "hardmode benchmark suite",
    "optional CUDA photographic matcher",
    "explicit backend selection and benchmark provenance",
    "local same-origin native bridge",
    "CUDA native host tests and Windows/Linux compiler CI"
  ],
  "vram_policy": "manual VRAM; warn above VRAM-4GiB; hard block above VRAM-2GiB; estimates do not equal actual free memory",
  "hardware_GPU_validation": "Not performed in container; high-resolution streaming exact-reference parity unverified",
